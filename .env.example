# Generate real local values with: python scripts/create_env.py
# This example intentionally cannot start the database without generated secrets.
COMPOSE_PROJECT_NAME=minishop
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
LAB_EXPERIMENT=E4
POSTGRES_DB=minishop
POSTGRES_USER=minishop_admin
POSTGRES_PASSWORD=
CATALOG_READER_PASSWORD=
CATALOG_READER_WIDE_PASSWORD=
ORDER_SERVICE_PASSWORD=
DEMO_USER1_PASSWORD=
DEMO_USER2_PASSWORD=
DEMO_USER1_PASSWORD_HASH=
DEMO_USER2_PASSWORD_HASH=
SESSION_COOKIE_SECURE=false
# create_env.py uses the invoking Linux user's UID/GID so reports are writable on Ubuntu.
TEST_UID=10001
TEST_GID=10001
